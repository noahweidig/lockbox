# Neon connection string (pooled)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# 32 random bytes, base64. Generate: openssl rand -base64 32
# Losing this key makes stored secrets unrecoverable. Never rotate without re-encrypting.
ENCRYPTION_KEY=

# Public base URL (used in emails). Optional on Vercel.
APP_URL=http://localhost:3000

# Email via Resend (https://resend.com). Without a key, links are logged in dev only.
RESEND_API_KEY=
EMAIL_FROM=LokBoks <noreply@yourdomain.com>
